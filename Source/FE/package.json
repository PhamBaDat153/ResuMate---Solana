{
  "name": "x402-template",
  "version": "0.1.0",
  "private": true,
  "displayName": "X402 Next.js",
  "description": "Next.js Solana starter with X402 payment protocol integration",
  "usecase": "Payments",
  "keywords": [
    "solana",
    "nextjs",
    "x402",
    "template",
    "starter"
  ],
  "create-solana-dapp": {
    "instructions": [
      "Install dependencies:",
      "+{pm} install",
      "Start dev server:",
      "+{pm} dev"
    ],
    "rename": {
      "project-name": {
        "to": "{{name}}",
        "paths": [
          "README.md",
          "src"
        ]
      }
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "^2.38.5",
    "x402-next": "^1.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "jsdom": "^24.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.1.6",
    "vitest": "^3.2.4"
  }
}
