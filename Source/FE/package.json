{
  "name": "x402-template",
  "version": "0.1.0",
  "private": true,
  "displayName": "X402 Next.js",
  "description": "Next.js Solana starter with X402 payment protocol integration",
  "usecase": "Payments",
  "keywords": [
    "solana",
    "nextjs",
    "x402",
    "template",
    "starter"
  ],
  "create-solana-dapp": {
    "instructions": [
      "Install dependencies:",
      "+{pm} install",
      "Start dev server:",
      "+{pm} dev"
    ],
    "rename": {
      "project-name": {
        "to": "{{name}}",
        "paths": [
          "README.md",
          "src"
        ]
      }
    }
  },
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev",
    "dev:webpack": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@solana/kit": "^8.2.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/kit-plugin-wallet": "^0.19.0",
    "@solana/react": "^8.2.0",
    "@x402/core": "^2.25.0",
    "@x402/fetch": "^2.25.0",
    "@x402/next": "^2.25.0",
    "@x402/svm": "^2.25.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.38.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
